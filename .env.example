# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AWS RDS Postgres (production auth)
DATABASE_URL=

# AWS Bedrock (assessment generation)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1

# Async AI jobs (optional — set NEXT_PUBLIC_USE_ASYNC_AI_JOBS=true when Lambda workers are deployed)
NEXT_PUBLIC_USE_ASYNC_AI_JOBS=false

# App URL
NEXT_PUBLIC_APP_URL=https://studysquare.org

# Flutterwave (subscriptions)
FLW_SECRET_KEY=
FLW_PUBLIC_KEY=
FLW_WEBHOOK_SECRET=
FLW_REDIRECT_URL=https://studysquare.org/subscription/success
# Subscription: $5 USD/month (converted at checkout for local currencies)
FLW_SUBSCRIPTION_AMOUNT_USD=5
NEXT_PUBLIC_SUBSCRIPTION_AMOUNT_USD=5
# Optional legacy fixed local pricing (leave unset to use USD conversion)
# FLW_SUBSCRIPTION_CURRENCY=RWF
# FLW_SUBSCRIPTION_AMOUNT=6500

# Optional: exam bank sync (npm run sync:exam-banks)
ALOC_API_TOKEN=

# Optional: textbook PDF roots for image extraction scripts
# TEXTBOOK_PDF_ROOTS=data/nerdc-textbooks
