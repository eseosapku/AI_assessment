# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Groq AI Configuration (free at console.groq.com)
GROQ_API_KEY=your_groq_api_key

# Public app URL (optional — used for absolute links in emails/scripts)
NEXT_PUBLIC_APP_URL=https://studysquare.org

# Aloc API token (optional — sync JAMB/WAEC question banks: npm run sync:exam-banks)
ALOC_API_TOKEN=your_aloc_token
