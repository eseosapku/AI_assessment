# Database (Amazon RDS / PostgreSQL)
DATABASE_URL=postgres://username:password@your-rds-endpoint:5432/brain_ink
PG_DISABLE_SSL=false

# Legacy Supabase public keys (keep only while old routes still use Supabase client)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_if_still_needed
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_if_still_needed

# Groq AI Configuration (free at console.groq.com)
GROQ_API_KEY=your_groq_api_key

# AWS Bedrock (server-side)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=eu-west-1
AWS_BEDROCK_MODEL_ID=eu.google.gemma-3-27b-it-v1:0

# Async AI jobs (Lambda worker migration)
NEXT_PUBLIC_USE_ASYNC_AI_JOBS=false
INTERNAL_JOB_RUNNER_TOKEN=replace_with_secure_random_token
