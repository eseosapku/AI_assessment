# Amazon RDS Postgres (required in production)
DATABASE_URL=
PG_DISABLE_SSL=false

# AWS Bedrock — Amplify blocks AWS_* prefix; use BEDROCK_* in production
BEDROCK_ACCESS_KEY_ID=
BEDROCK_SECRET_ACCESS_KEY=
BEDROCK_REGION=eu-west-1
# Local dev may also use:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-west-1

# Async AI jobs (optional — set NEXT_PUBLIC_USE_ASYNC_AI_JOBS=true when Lambda workers are deployed)
NEXT_PUBLIC_USE_ASYNC_AI_JOBS=false

# App URL
NEXT_PUBLIC_APP_URL=https://studysquare.org

# Flutterwave (subscriptions) — on Amplify, also listed in amplify.yml for SSR runtime
FLW_SECRET_KEY=FLW_PUBLIC_KEY=
FLW_WEBHOOK_SECRET=
FLW_REDIRECT_URL=https://studysquare.org/subscription/success
# Subscription: $5 USD/month (converted at checkout for local currencies)
FLW_SUBSCRIPTION_AMOUNT_USD=5
NEXT_PUBLIC_SUBSCRIPTION_AMOUNT_USD=5
# Rwanda fixed monthly price (RWF) — not FX-converted
FLW_SUBSCRIPTION_AMOUNT_RWF=1500
NEXT_PUBLIC_SUBSCRIPTION_AMOUNT_RWF=1500
# Optional legacy fixed local pricing for other currencies
# FLW_SUBSCRIPTION_CURRENCY=NGN
# FLW_SUBSCRIPTION_AMOUNT=5000

# Optional: exam bank sync (npm run sync:exam-banks)
ALOC_API_TOKEN=

# Optional: textbook PDF roots for image extraction scripts
# TEXTBOOK_PDF_ROOTS=data/nerdc-textbooks
