# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Groq AI Configuration (free at console.groq.com)
GROQ_API_KEY=your_groq_api_key

# Public app URL (used for Flutterwave redirect + webhook URLs)
NEXT_PUBLIC_APP_URL=https://studysquare.org

# Aloc API token (optional — sync JAMB/WAEC question banks: npm run sync:exam-banks)
ALOC_API_TOKEN=your_aloc_token

# Flutterwave v3 LIVE keys — Dashboard → Settings → Developers → API keys
FLW_SECRET_KEY=FLWSECK-xxxxxxxxxxxxxxxxxxxxx-X
FLW_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxxxxxxxxxxx-X
# v3 webhook: Settings → Webhooks → Secret hash (any string; same value here)
FLW_WEBHOOK_SECRET=your_webhook_secret_hash
# Optional: pre-created monthly plan id (otherwise auto-created on first checkout)
FLW_PLAN_ID=
# Redirect after checkout (defaults to NEXT_PUBLIC_APP_URL/subscription/success)
FLW_REDIRECT_URL=https://studysquare.org/subscription/success
# Base price in USD before currency conversion (default 5)
FLW_SUBSCRIPTION_AMOUNT_USD=5
